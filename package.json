{
  "name": "python-junior-mock",
  "productName": "Python Junior Mock",
  "version": "1.3.5",
  "private": true,
  "main": "src/main.js",
  "scripts": {
    "start": "npm run icon:render && electron .",
    "test": "node --test && node --check src/renderer.js && node --check src/main.js && node --check src/pdf-printer.js && node --check src/transcript-tracker.js",
    "test:pdf": "electron scripts/pdf-smoke.js",
    "test:ui": "electron scripts/ui-smoke.js",
    "icon:render": "electron scripts/render-icon.js",
    "icon": "npm run icon:render && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-icon.ps1",
    "dist": "npm run icon && electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.pythonjuniormock.windows",
    "productName": "Python Junior Mock",
    "directories": {"output": "dist"},
    "files": ["src/**/*", "assets/**/*", "package.json"],
    "win": {"icon": "assets/quickcue-graphite.ico", "target": [{"target": "nsis", "arch": ["x64"]}]},
    "nsis": {
      "installerIcon": "assets/quickcue-graphite.ico",
      "uninstallerIcon": "assets/quickcue-graphite.ico",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "Python-Junior-Mock-Setup-${version}.exe"
    }
  }
}
